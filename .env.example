# LinguaLearn 环境变量（精简版）
# 用法：cp .env.example .env

# ============================================================================
# A. 主 LLM（全局默认）
# 用于：词汇分析、翻译、以及默认的句子分割/Tutor（若设置为 inherit）
# ============================================================================
# 可选：deepseek | openai | gemini | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# ============================================================================
# B. Sentence Splitter（句子分割）
# ============================================================================
# 可选：inherit（默认，复用主 LLM）| custom（单独配置）
SPLITTER_PROVIDER=inherit
SPLITTER_MODEL=deepseek-reasoner
# 仅在 SPLITTER_PROVIDER=custom 时填写
SPLITTER_API_KEY=
SPLITTER_BASE_URL=

# ============================================================================
# C. Tutor LLM（AI讲课/随身听脚本）
# ============================================================================
# 可选：inherit（默认，复用主 LLM）| deepseek | openai | gemini | custom
TUTOR_PROVIDER=inherit
TUTOR_MODEL=deepseek-reasoner
# 仅在 TUTOR_PROVIDER 不是 inherit 时按需覆盖
TUTOR_API_KEY=
TUTOR_BASE_URL=

# 便捷切换（可选）
# OPENAI_GPT_API_KEY=
# OPENAI_GPT_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ============================================================================
# D. TTS（语音合成）
# ============================================================================
# 可选：minimax | openai | elevenlabs | azure
TTS_PROVIDER=minimax
TTS_MODEL=speech-2.8-turbo
TTS_API_KEY=

# 通用语音参数
TTS_VOICE=male-qn-qingse
TTS_ENDPOINT=https://api.minimax.io/v1/t2a_v2

# MiniMax 额外参数（provider=minimax）
# 文稿可用停顿标记：<#0.25#>（秒）
TTS_OUTPUT_FORMAT=hex
TTS_LANGUAGE_BOOST=auto
TTS_SAMPLE_RATE=32000
TTS_BITRATE=128000
TTS_CHANNEL=1

# 兼容旧变量（可不填）
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
MINIMAX_TTS_ENDPOINT=
MINIMAX_TTS_OUTPUT_FORMAT=

# ElevenLabs（provider=elevenlabs）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Azure（provider=azure）
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE=en-US-JennyNeural

# ============================================================================
# E. 词典
# ============================================================================
# 可选：wiktextract | oxford
DICT_MODE=wiktextract
DICT_DB_PATH=data/wiktextract_trans.sqlite3

# 仅在 DICT_MODE=oxford 时需要
DICT_OXFORD_BASE_URL=https://od-api-sandbox.oxforddictionaries.com/api/v2
DICT_OXFORD_APP_ID=
DICT_OXFORD_APP_KEY=
DICT_OXFORD_DATASET=en-gb
DICT_OXFORD_TIMEOUT_SEC=8.0

# 高级开关（可选）
# DICT_REMOTE_LOOKUP_TIMEOUT_SEC=1.2
# DICT_TRANSLATE_TIMEOUT_SEC=1.5
# DICT_ENABLE_REMOTE_FALLBACK=0
# DICT_ENABLE_LLM_TRANSLATION=1
# DICT_ENABLE_OXFORD=1
# DICT_ONLY_OXFORD=0

# ============================================================================
# F. 其它可选
# ============================================================================
WHISPER_MODEL_SIZE=small
VIDEO_RESOLUTION=1080p
PORT=8080
RESEND_API_KEY=

# ============================================================================
# G. 支付（做会员支付时再配）
# ============================================================================
APP_BASE_URL=http://localhost:8080

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CN_DAY=
STRIPE_PRICE_CN_WEEK=
STRIPE_PRICE_CN_MONTH=
STRIPE_PRICE_CN_YEAR=
STRIPE_PRICE_INTL_DAY=
STRIPE_PRICE_INTL_WEEK=
STRIPE_PRICE_INTL_MONTH=
STRIPE_PRICE_INTL_YEAR=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_RETURN_URL=
ALIPAY_NOTIFY_URL=
