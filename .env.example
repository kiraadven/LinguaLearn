# LinguaLearn 环境配置模板
# 复制此文件为 .env，然后根据下面的说明填写配置

# ===== LLM API 配置（必填）=====
# 推荐使用 DeepSeek（价格低、速度快）
# 也支持 OpenAI、Claude 等兼容 OpenAI 格式的服务

# 词汇分析和翻译用 API
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com

# 分句专用 API（可选，不填则使用上面的配置）
# 如果想用更快的模型进行分句（如 OpenAI gpt-3.5-turbo），可以配置这里
SPLITTER_API_KEY=sk-xxxx
SPLITTER_BASE_URL=https://api.deepseek.com
SPLITTER_MODEL=deepseek-chat

# ===== Whisper 模型配置（可选）=====
# 模型大小：tiny / base / small（推荐）/ medium / large
# tiny / base：快速但准确度较低（适合测试）
# small：平衡性能和准确度（推荐）
# medium / large：准确度高但速度慢
WHISPER_MODEL_SIZE=small

# ===== 邮件配置（可选）=====
# 如果不配置，验证码将在服务器控制台打印（适合本地开发）
# Resend 是推荐的邮件服务，获取 API Key：https://resend.com
RESEND_API_KEY=re_xxxx

# ===== 视频分辨率（可选）=====
# 1080p：高质量，生成速度较慢
# 720p：快速处理，适合测试
# 默认：1080p
VIDEO_RESOLUTION=1080p
